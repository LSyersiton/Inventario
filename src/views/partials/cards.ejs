<% productos.forEach(producto => { %>
<Article class="card-product">
    <div class="title"><h3><%= producto.nombre %> </h3></div>
    <div class="body-card">
        <img src="/img/imagen_durisima.png" alt="imagen_durisima">
    </div>
    <div class="footer-card">
        <p><%= producto.descripcion %> </p>
        <p>Stock: <%= producto.stock %> </p>
        <p>Precio: <%= producto.precio %> </p>
       
        <div class="button-container">
            <button class="button button-buy">Comprar</button>
            <button class="button button-see">Ver producto</button>
        </div>
    </div>
</Article>
<% }) %>
